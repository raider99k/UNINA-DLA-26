# Auto-detect text files and normalize line endings
* text=auto

# Shell scripts must strictly use LF
*.sh text eol=lf

# C/C++ and CUDA sources
*.cpp text
*.hpp text
*.cu text
*.cuh text
*.cmake text
CMakeLists.txt text

# Python sources
*.py text
*.pyi text

# Documentation & Configurations
*.md text
*.yaml text
*.yml text
*.toml text
*.json text
*.xml text

# Binary models and weights
*.pt binary
*.pth binary
*.onnx binary
*.engine binary
*.plan binary
